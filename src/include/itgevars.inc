; Переменные itge.sys, которые видит ядро (лежат в модуле по постоянным адресам)
IJ        equ 0x48010                   ; таблица переходов модуля
IV        equ 0x48100                   ; переменные модуля
d2_itge   equ IV + 0                    ; 1 - itge открыта
it_drag   equ IV + 1                    ; 0 нет, 1 двигаем, 2 вращаем (ядро зовёт itge_move, пока кнопка мыши нажата)
it_shift  equ IV + 2                    ; Shift нажат (ядро кладёт перед нажатием мыши)
it_dsk    equ IV + 3                    ; диск файла (0xFF - файла ещё нет)
it_par    equ IV + 4                    ; папка файла
it_nm     equ IV + 16                   ; имя файла (16 байт)
it_cur    equ IV + 5                    ; какой курсор показывать, пока тянут картинку за угол
